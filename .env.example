# 复制为 .env 后修改

# 服务端口
PORT=3000

# SQLite 数据目录。部署到持久磁盘时挂载到这个目录。
DATA_DIR=./data

# 是否托管游戏前端静态文件（生产建议交给 Nginx/Caddy，可设为空关闭）
# 指向 trick-brick 游戏目录（相对 server 工程根目录）
GAME_DIR=../trick-brick

# 管理员登录口令。生产必须改成强口令。
ADMIN_PASSWORD=changeme

# IP 哈希加盐（P2 启用）。务必改成随机长字符串
IP_SALT=please-change-this-salt

# JWT / session 密钥（P3 启用）
JWT_SECRET=please-change-this-secret

# 允许跨域来源（游戏与后端不同域名时填游戏地址；同域可留空）
CORS_ORIGIN=
