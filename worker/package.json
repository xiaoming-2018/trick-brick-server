{
  "name": "trick-brick-worker",
  "version": "0.1.0",
  "description": "会捣乱的积木 · 后台（Cloudflare Workers + D1 版）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build-assets.sh",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute trick-brick --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute trick-brick --local --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
